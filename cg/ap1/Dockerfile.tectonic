FROM debian:bookworm-slim

# The upstream installer downloads one self-contained Tectonic executable.
# Pin the image's Tectonic version by changing this argument when upgrading.
ARG TECTONIC_VERSION=0.17.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz -C /usr/local/bin \
    && chmod 0755 /usr/local/bin/tectonic

WORKDIR /work
ENTRYPOINT ["tectonic"]
